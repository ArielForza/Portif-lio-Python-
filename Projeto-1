import pyautogui # puxar biblioteca
import time # puxar biblioteca
import pandas # puxar biblioteca

pyautogui.PAUSE = 0.5 #define pausa de 0,5 segundoas entre cada comando.
link = "https://dlp.hashtagtreinamentos.com/python/intensivao/login" # apelido para o link 
mail = "pythonimpressionador@gmail.com"
senha = "sua senha muito muito muito dificilima"
tabela = pandas.read_csv("produtos.csv")

# 1 - entrar no sistema
pyautogui.press("win") # clicar a tecla windows
pyautogui.write("Edge") # escreve Edge.
pyautogui.press("enter") # clicar a tecla Enter.

# 2 - Fazer LOgin
pyautogui.write(link) # escrever texto equivalente a link
pyautogui.press("enter") # clicar a tecla Enter.
pyautogui.click(x=1654, y=400) #clica na pozição indicada
time.sleep(1) #Espera 3 segunda para executar a função anterior
pyautogui.write(mail) # escrever texto equivalente a mail
pyautogui.press("tab") #passar para proximo campo apertando tab
pyautogui.write(senha) # escrever texto equivalente a senha
pyautogui.click(x=1936, y=572) #clica na pozição indicada
time.sleep(4) #Espera 3 segunda para executar a função anterior

# 3 - Abrir base de dados
print(tabela)

# 5 - repetidor do estagio 4
for linha in tabela.index: # linha indica comando pode ser qualquer nome; index é o comando para linhas.
    # 4 - Casdastrar produto
    #codigo
    codigo = str(tabela.loc[linha,"codigo"])
    pyautogui.click(x=1661, y=295) #clica na pozição produtos
    pyautogui.write(codigo) # escrever codigo
    #Marca
    marca = str(tabela.loc[linha,"marca"])
    pyautogui.press("tab") #passar para proximo campo apertando tab
    pyautogui.write(marca) # escrever marca
    #Tipo
    tipo = str(tabela.loc[linha,"tipo"])
    pyautogui.press("tab") #passar para proximo campo apertando tab
    pyautogui.write(tipo) # escrever tipo
    #categoria
    categoria = str(tabela.loc[linha,"categoria"])
    pyautogui.press("tab") #passar para proximo campo apertando tab
    pyautogui.write(categoria) # escrever categoria
    #preco_unitario
    preco = str(tabela.loc[linha,"preco_unitario"])
    pyautogui.press("tab") #passar para proximo campo apertando tab
    pyautogui.write(preco) # escrever preco_unitario
    #custo
    custo = str(tabela.loc[linha,"custo"])
    pyautogui.press("tab") #passar para proximo campo apertando tab
    pyautogui.write(custo) # escrever custo
    #obs
    obs = str(tabela.loc[linha,"obs"])
    pyautogui.press("tab") #passar para proximo campo apertando tab
    if obs != "nan":
        pyautogui.write(obs) # escrever obs
    #Enviar
    pyautogui.press("tab") #passar para proximo campo apertando tab
    pyautogui.press("enter") # clicar a tecla Enter.
    pyautogui.scroll(+5000)

